# OpenRIDE - Java services environment example
# Copy this file to each Java service root (or to the shared java root)
# Fill in real secrets before deployment. Do NOT commit secrets to public repos.

# -----------------------------
# Database (Postgres)
# -----------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=openride
DB_USER=openride
DB_PASSWORD=change_me

# Spring datasource (optional convenience; some services build DB URL from above)
SPRING_DATASOURCE_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}
SPRING_DATASOURCE_USERNAME=${DB_USER}
SPRING_DATASOURCE_PASSWORD=${DB_PASSWORD}
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# -----------------------------
# Application & Environment
# -----------------------------
SPRING_PROFILES_ACTIVE=production
APP_ENV=production
LOG_LEVEL=INFO

# -----------------------------
# Security / Tokens
# -----------------------------
JWT_SECRET=replace_with_a_secure_random_hex_or_base64
JWT_EXPIRATION_SECONDS=3600

# -----------------------------
# Redis (caching/locks/session)
# -----------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------------------
# Kafka (events/streaming)
# -----------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_USERNAME=
KAFKA_PASSWORD=

# -----------------------------
# External Integrations
# -----------------------------
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email / SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@yourdomain.com

# -----------------------------
# Service ports (override per-service if needed)
# -----------------------------
AUTH_PORT=8081
USER_PORT=8082
BOOKING_PORT=8083
PAYMENTS_PORT=8084
PAYOUTS_PORT=8085
TICKETING_PORT=8086
ADMIN_PORT=8087

# -----------------------------
# Notes
# - Copy this file to each droplet under `~/openride-backend/services/java/` or into each service directory
# - Replace placeholder values before running services
# - Keep secrets out of source control; use your CI/CD secrets or droplet environment variables where possible
