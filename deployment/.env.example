# ===================================
# OpenRIDE Backend - Environment Configuration
# ===================================
# Production deployment configuration

# ===================================
# Deployment Configuration
# ===================================
ENVIRONMENT=production
TAG=latest
REGISTRY=ghcr.io/davidx345

# ===================================
# Database (Supabase PostgreSQL)
# ===================================
# Python services (asyncpg driver for async SQLAlchemy)
#DATABASE_URL=postgresql+asyncpg://postgres.ogxvfdmkkszbwwmwtyue:ayodele3579@aws-1-eu-west-1.pooler.supabase.com:6543/postgres
# Java services (JDBC driver for Spring Boot)
# prepareThreshold=0 disables server-side prepared statements for transaction pooling compatibility
#JDBC_DATABASE_URL=jdbc:postgresql://aws-1-eu-west-1.pooler.supabase.com:6543/postgres?user=postgres.ogxvfdmkkszbwwmwtyue&password=ayodele3579&prepareThreshold=0

# ===================================
# Redis (Cloud Redis) - Full URL with Auth
# ===================================
#REDIS_URL=redis://default:yjgLl5SUWYxcRhgzWJOVpMkkhGYDpAzO@redis-16685.c85.us-east-1-2.ec2.redns.redis-cloud.com:16685/0

# ===================================
# Authentication & Security
# ===================================
#JWT_SECRET=your-secret-jwt-key-change-this-in-production-use-openssl-rand-hex-32

# ===================================
# Service URLs (Internal Docker Network)
# ===================================
# Use container names for internal communication
USER_SERVICE_URL=http://user-service:8083 
DRIVER_SERVICE_URL=http://driver-service:8000
MATCHMAKING_SERVICE_URL=http://matchmaking-service:8084
SEARCH_SERVICE_URL=http://search-service:8085
BOOKING_SERVICE_URL=http://booking-service:8086
NOTIFICATION_SERVICE_URL=http://notification-service:8095
ANALYTICS_SERVICE_URL=http://analytics-service:8097
FLEET_SERVICE_URL=http://fleet-service:8096

# ===================================
# Twilio (SMS & Phone Verification)
# ===================================
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ===================================
# SendGrid (Email Notifications)
# ===================================
SENDGRID_API_KEY=SG.your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@openride.com

# ===================================
# Firebase Cloud Messaging (Push Notifications)
# ===================================
FCM_PROJECT_ID=your-firebase-project-id
FCM_CREDENTIALS=base64-encoded-service-account-json

# ===================================
# ClickHouse (Analytics - Optional)
# ===================================
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your-clickhouse-password
CLICKHOUSE_DATABASE=openride_analytics

# ===================================
# Elasticsearch (Search - Optional)
# ===================================
ELASTICSEARCH_URL=http://localhost:9200

# ===================================
# Logging
# ===================================
LOG_LEVEL=INFO
