# ===================================
# OpenRIDE Backend - Environment Configuration
# ===================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file with real secrets to Git

# ===================================
# Deployment Configuration
# ===================================
ENVIRONMENT=production
TAG=latest
REGISTRY=ghcr.io/davidx345

# ===================================
# Database (Supabase PostgreSQL)
# ===================================
# IMPORTANT: Using Transaction Pooler (port 6543) instead of Session Pooler (port 5432)
# Transaction pooling allows better connection scaling but requires:
# - Python: NullPool in SQLAlchemy (already configured)
# - Java: prepareThreshold=0 in JDBC URL (already configured)
#SUPABASE_URL=https://ogxvfdmkkszbwwmwtyue.supabase.co
#SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im9neHZmZG1ra3N6Ynd3bXd0eXVlIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjU4NjIyNjUsImV4cCI6MjA4MTQzODI2NX0.xYaUkWCPp3FGDJ36b_w7gN1eNR6QFVLb2ZKu1e9CvUU
# Python services (asyncpg driver for async SQLAlchemy) - port 6543 for transaction pooler
#DATABASE_URL=postgresql+asyncpg://postgres.ogxvfdmkkszbwwmwtyue:password@aws-1-eu-west-1.pooler.supabase.com:6543/postgres
# Java services (JDBC driver for Spring Boot) - prepareThreshold=0 required for transaction pooling
#JDBC_DATABASE_URL=jdbc:postgresql://aws-1-eu-west-1.pooler.supabase.com:6543/postgres?user=postgres.ogxvfdmkkszbwwmwtyue&password=password&prepareThreshold=0
#REDIS_URL=redis://default:password@redis-host.redis-cloud.com:16685/0
# ===================================
# Redis (Optional - use managed or self-hosted)
# ===================================


# ===================================
# Authentication & Security
# ===================================
# Generate with: openssl rand -hex 32
#JWT_SECRET=ayodele3579

# ===================================
# Twilio (SMS & Phone Verification)
# ===================================
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ===================================
# Stripe (Payment Processing)
# ===================================
STRIPE_API_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ===================================
# SendGrid (Email Notifications)
# ===================================
SENDGRID_API_KEY=SG.your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# ===================================
# Firebase Cloud Messaging (Push Notifications)
# ===================================
FCM_PROJECT_ID=your-firebase-project-id
FCM_CREDENTIALS=base64-encoded-service-account-json

# ===================================
# ClickHouse (Analytics - Optional)
# ===================================
CLICKHOUSE_HOST=your-clickhouse-host.com
CLICKHOUSE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your-clickhouse-password
CLICKHOUSE_DATABASE=openride_analytics

# ===================================
# Elasticsearch (Search - Optional)
# ===================================
ELASTICSEARCH_URL=https://your-elasticsearch-url.com:9200

# ===================================
# Logging
# ===================================
LOG_LEVEL=INFO
USER_SERVICE_URL=http://user-service:8083
DRIVER_SERVICE_URL=http://driver-service:8000
MATCHMAKING_SERVICE_URL=http://matchmaking-service:8084
SEARCH_SERVICE_URL=http://search-service:8085
BOOKING_SERVICE_URL=http://booking-service:8086
NOTIFICATION_SERVICE_URL=http://notification-service:8095
ANALYTICS_SERVICE_URL=http://analytics-service:8097
FLEET_SERVICE_URL=http://fleet-service:8096