# ===================================
# OpenRIDE Backend - Environment Configuration
# ===================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file with real secrets to Git

# ===================================
# Deployment Configuration
# ===================================
ENVIRONMENT=production
TAG=latest
REGISTRY=ghcr.io/davidx345

# ===================================
# Database (Supabase PostgreSQL)
# ===================================
# Get these from Supabase dashboard: Settings > Database
DB_HOST=db.your-project.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-supabase-password

# ===================================
# Redis (Optional - use managed or self-hosted)
# ===================================
# Use a managed Redis or install on a small droplet
REDIS_HOST=your-redis-host.com
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# ===================================
# Authentication & Security
# ===================================
# Generate with: openssl rand -hex 32
JWT_SECRET=your-secret-jwt-key-change-this-in-production

# ===================================
# Twilio (SMS & Phone Verification)
# ===================================
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ===================================
# Stripe (Payment Processing)
# ===================================
STRIPE_API_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ===================================
# SendGrid (Email Notifications)
# ===================================
SENDGRID_API_KEY=SG.your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# ===================================
# Firebase Cloud Messaging (Push Notifications)
# ===================================
FCM_PROJECT_ID=your-firebase-project-id
FCM_CREDENTIALS=base64-encoded-service-account-json

# ===================================
# ClickHouse (Analytics - Optional)
# ===================================
CLICKHOUSE_HOST=your-clickhouse-host.com
CLICKHOUSE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your-clickhouse-password
CLICKHOUSE_DATABASE=openride_analytics

# ===================================
# Elasticsearch (Search - Optional)
# ===================================
ELASTICSEARCH_URL=https://your-elasticsearch-url.com:9200

# ===================================
# Logging
# ===================================
LOG_LEVEL=INFO
